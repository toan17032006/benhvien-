# ===== Google Sign-In (đăng nhập/đăng ký bằng Google) =====
# 1. Tạo OAuth 2.0 Client ID tại https://console.cloud.google.com/apis/credentials
#    - Application type: Web application
#    - Authorized JavaScript origins: http://localhost:3000
# 2. Điền Client ID vào biến bên dưới (frontend) VÀ biến môi trường
#    GOOGLE_CLIENT_ID của backend (hoặc sửa trực tiếp application.yml).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ===== API backend (không bắt buộc) =====
# Frontend mặc định proxy /api tới http://localhost:8081 (xem next.config.mjs).
API_URL=
